MYSQL_DATABASE=vogel_gestion_servicios
MYSQL_USER=vogel
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root
DATABASE_URL=mysql+pymysql://vogel:change_me@db:3306/vogel_gestion_servicios
JWT_SECRET=change_me_long_random_secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Orígenes permitidos para llamadas directas al backend. Con el proxy same-origin de
# nginx no hace falta en el deploy, pero el dev sin Docker sigue hablando 5173 -> 8000
# y depende de esto. Ojo: docker compose tambien lee este archivo para los build args,
# asi que dejar VITE_API_URL con valor absoluto reintroduce el CORS.
CORS_ORIGINS=http://localhost:5173

# URL de la API que usa el browser. Relativa = mismo origen: pide /api/v1 y nginx lo
# proxea al backend, sin CORS. Con valor absoluto se vuelve a cruzar origenes.
# Dev sin Docker: usar http://localhost:8000/api/v1
VITE_API_URL=/api/v1

# Base del backend a la que proxea nginx, sin trailing slash. Se hornea en la imagen
# durante el build, asi que cambiarla exige rebuild del frontend.
#   compose:        http://backend:8000
#   apps separadas: https://<backend>.sslip.io
BACKEND_INTERNAL_URL=http://backend:8000
